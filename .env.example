# ==========================================
# Configurações de Ambiente — AdotaMatch Backend
# ==========================================

# Porta da API REST
SERVER_PORT=8080

# Profile do Spring (dev / prod / test)
SPRING_PROFILES_ACTIVE=dev

# Conexão com Banco de Dados Relacional
DATABASE_URL=jdbc:h2:mem:adotamatchdb
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Integração com Modelo de Linguagem de Grande Porte (LLM)
LLM_PROVIDER=mock-fallback
LLM_API_KEY=your_llm_api_key_here
LLM_TIMEOUT_MS=5000
